    "import os\n",
    "\n",
    "# Function to extract characters from transcriptions\n",
    "def extract_chars_from_file(file_path):\n",
    "    charset = set()\n",
    "    try:\n",
    "        with open(file_path, 'r', encoding='utf-8') as f:\n",
    "            for line in f:\n",
    "                line = line.strip()\n",
    "                if line:\n",
    "                    # Split by spaces and take everything after the filename (first element)\n",
    "                    parts = line.split(' ')\n",
    "                    if len(parts) > 1:\n",
    "                        # Join all parts after the filename to get the transcription\n",
    "                        transcription = ' '.join(parts[1:])\n",
    "                        # Add all characters to charset\n",
    "                        charset.update(transcription)\n",
    "    except Exception as e:\n",
    "        print(f"Error reading {file_path}: {e}")\n",
    "    return charset\n",
    "\n",
    "# List of source files\n",
    "source_files = [\n",
    "    'nan_raw_biner/train/lines.txt',\n",
    "    'nan_raw_biner/test/lines.txt', \n",
    "    'nan_raw_biner/validation/lines.txt'\n",
    "]\n",
    "\n",
    "# Special tokens to include first\n",
    "special_tokens = ['<UNK>', '<SPACE>', '<PAD>', '|']\n",
    "\n",
    "# Collect all unique characters\n",
    "all_chars = set()\n",
    "all_chars.update(special_tokens)\n",
    "\n",
    "# Extract characters from each file\n",
    "for file_path in source_files:\n",
    "    if os.path.exists(file_path):\n",
    "        chars = extract_chars_from_file(file_path)\n",
    "        all_chars.update(chars)\n",
    "        print(f"Extracted {len(chars)} characters from {file_path}")\n",
    "    else:\n",
    "        print(f"File not found: {file_path}")\n",
    "\n",
    "# Convert to sorted list\n",
    "char_list = sorted(list(all_chars))\n",
    "\n",
    "# Write to CHAR_LIST file\n",
    "output_path = 'Sets/CHAR_LIST_2'\n",
    "os.makedirs(os.path.dirname(output_path), exist_ok=True)\n",
    "\n",
    "with open(output_path, 'w', encoding='utf-8') as f:\n",
    "    for char in char_list:\n",
    "        f.write(char + '\n')\n",
    "\n",
    "print(f"\nGenerated CHAR_LIST with {len(char_list)} characters:")\n",
    "print("First 10 characters:", char_list[:10])\n",
    "print("Last 10 characters:", char_list[-10:])\n",
    "print(f"\nCHAR_LIST saved to: {output_path}")"
   ]
  },
