    "import os\n",
    "\n",
    "# Read source file and extract filenames without extensions\n",
    "with open('nan_raw_biner/train/lines.txt', 'r') as f:\n",
    "    filenames = [line.strip() for line in f.readlines()]\n",
    "\n",
    "# Remove file extensions\n",
    "base_names = [os.path.splitext(name)[0] for name in filenames]\n",
    "\n",
    "# Write to output file\n",
    "with open('Sets/list_train_nan.txt', 'w') as f:\n",
    "    f.write('\n'.join(base_names))"
   ]
