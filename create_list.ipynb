    "import os",
    "",
    "# File paths",
    "test_file = 'nan_raw_biner/test/lines.txt'",
    "train_file = 'nan_raw_biner/train/lines.txt'",
    "validation_file = 'nan_raw_biner/validation/lines.txt'",
    "output_file = 'Sets/lines2.txt'",
    "",
    "# Ensure the output directory exists",
    "os.makedirs(os.path.dirname(output_file), exist_ok=True)",
    "",
    "# Combine the first 5 lines of each file",
    "with open(output_file, 'w', encoding='utf-8') as outfile:",
    "    for in_file in [test_file, train_file, validation_file]:",
    "        if os.path.exists(in_file):",
    "            with open(in_file, 'r', encoding='utf-8') as infile:",
    "                for i, line in enumerate(infile):",
    "                    if i < 5:",
    "                        outfile.write(line)",
    "                    else:",
    "                        break",
    "        else:",
    "            print(f"File not found: {in_file}")",
    "",
    "print(f"Combined file created at: {output_file}")"
   ]
  }
